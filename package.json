{
  "name": "mcp-server-kakao-map",
  "version": "0.3.2",
  "mcpName": "io.github.bong-u/mcp-server-kakao-map",
  "description": "MCP server exposing Kakao Local REST APIs (place search, address, geocoding, coord conversion) as discrete tools.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "kakao",
    "kakao-map",
    "kakaomap",
    "kakao-local",
    "geocoding",
    "reverse-geocoding",
    "place-search",
    "korea",
    "카카오맵",
    "카카오지도"
  ],
  "license": "MIT",
  "author": "bong-u",
  "homepage": "https://github.com/bong-u/mcp-server-kakao-map#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bong-u/mcp-server-kakao-map.git"
  },
  "bugs": {
    "url": "https://github.com/bong-u/mcp-server-kakao-map/issues"
  },
  "type": "module",
  "bin": {
    "mcp-server-kakao-map": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "tsx --env-file=.env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "tsx --env-file=.env tests/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
